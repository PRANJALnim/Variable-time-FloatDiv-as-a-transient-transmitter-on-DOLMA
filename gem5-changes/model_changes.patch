diff --git a/src/cpu/o3/inst_queue_impl.hh b/src/cpu/o3/inst_queue_impl.hh
index c5a6a1d..e3742a5 100644
--- a/src/cpu/o3/inst_queue_impl.hh
+++ b/src/cpu/o3/inst_queue_impl.hh
@@ -51,6 +51,7 @@
 #include "cpu/o3/fu_pool.hh"
 #include "cpu/o3/inst_queue.hh"
 #include "debug/IQ.hh"
+#include "debug/FloatDivChan.hh"
 #include "enums/OpClass.hh"
 #include "params/DerivO3CPU.hh"
 #include "sim/core.hh"
@@ -764,6 +765,8 @@ void
 InstructionQueue<Impl>::processFUCompletion(DynInstPtr &inst, int fu_idx)
 {
     DPRINTF(IQ, "Processing FU completion [sn:%lli]\n", inst->seqNum);
+    if (inst->staticInst->opClass() == FloatDivOp || inst->staticInst->opClass() == SimdFloatDivOp)
+        DPRINTF(FloatDivChan, "[sn:%lli] tid=%i FREE FloatDiv free_tick=%llu squashed=%d\n", inst->seqNum, inst->threadNumber, (unsigned long long)curTick(), inst->isSquashed());
     assert(!cpu->switchedOut());
     // The CPU could have been sleeping until this op completed (*extremely*
     // long latency op).  Wake it if it was.  This may be overkill.
@@ -948,6 +951,26 @@ InstructionQueue<Impl>::scheduleReadyInsts()
             }
             if (idx > FUPool::NoFreeFU) {
                 op_latency = fuPool->getOpLatency(op_class);
+                // ==== variable-time FloatDiv covert-channel hook ====
+                if (op_class == FloatDivOp || op_class == SimdFloatDivOp) {
+                    bool trivial = false;
+                    for (int i = 0; i < issuing_inst->numSrcRegs(); ++i) {
+                        if (!issuing_inst->srcRegIdx(i).isFloatReg())
+                            continue;
+                        uint64_t bits = cpu->readFloatRegBits(
+                                            issuing_inst->renamedSrcRegIdx(i));
+                        DPRINTF(IQ, "[sn:%i] FloatDiv src%d bits=%#lx\n",
+                                issuing_inst->seqNum, i, (unsigned long)bits);
+                        if ((bits & 0x7fffffffffffffffULL) == 0ULL)
+                            trivial = true;
+                    }
+                    op_latency = trivial ? Cycles(6) : Cycles(24);
+                    DPRINTF(FloatDivChan, "[sn:%lli] tid=%i ISSUE FloatDiv trivial=%d op_latency=%d issue_tick=%llu restricted=%d ctrl=%d data=%d squashed=%d\n", issuing_inst->seqNum, tid, trivial, op_latency, (unsigned long long)curTick(), issuing_inst->isDolmaRestricted(), issuing_inst->isControlRestricted(), issuing_inst->isDataRestricted(), issuing_inst->isSquashed());
+                    DPRINTF(IQ, "[sn:%i] FloatDiv variable-time: numSrc=%d "
+                                "trivial=%d op_latency=%d\n",
+                            issuing_inst->seqNum, issuing_inst->numSrcRegs(),
+                            trivial, op_latency);
+                }
             }
         }
 
